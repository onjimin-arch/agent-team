# ────────────────────────────────────────────
# Slack App 토큰 설정
# ────────────────────────────────────────────
#
# 1. https://api.slack.com/apps 에서 앱 생성
#
# 2. "Socket Mode" 탭 → Enable Socket Mode ON
#    → App-Level Token 생성 (connections:write 스코프)
#    → 아래 SLACK_APP_TOKEN 에 붙여넣기 (xapp-1- 로 시작)
#
# 3. "OAuth & Permissions" 탭 → Bot Token Scopes 추가:
#    app_mentions:read, chat:write
#    → 워크스페이스에 설치 후 Bot User OAuth Token 복사
#    → 아래 SLACK_BOT_TOKEN 에 붙여넣기 (xoxb- 로 시작)
#
# 4. "Event Subscriptions" 탭 → Enable Events ON
#    → Subscribe to Bot Events: app_mention 추가
#
# ────────────────────────────────────────────

SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# 에이전트 작업 타임아웃 (초 단위, 기본 600 = 10분)
AGENT_TIMEOUT=600

# queue_server.py 역보고 대상 (Slack 사용자 ID 또는 채널명)
# 사용자 DM: Slack 프로필 → 더보기 → "멤버 ID 복사" 후 붙여넣기
SLACK_REPORT_CHANNEL=U3H2A2V0E

# deploy-heal 스킬 사용 시 서비스 기본 포트
PROD_PORT=8000
