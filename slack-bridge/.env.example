# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# 허용 사용자 Slack User ID (본인 외 DM·멘션 무시)
SLACK_ALLOWED_USER_ID=U0XXXXXXX
# 여러 명 허용 시 콤마 구분 (SLACK_ALLOWED_USER_ID 와 합산)
# SLACK_ALLOWED_USER_IDS=U0XXXXXXX,U1YYYYYYY

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Agent runtime
# TEAM_ROOT: agent-team 폴더 절대경로 (슬래시 방향 무관)
TEAM_ROOT=C:/Users/<USERNAME>/OneDrive - 바로고/문서/클로드 코드 에이전트/agent-team

# opencode 모델 ID (anthropic/ prefix 없으면 자동 추가)
AGENT_MODEL=claude-sonnet-4-6

# Webhook URL 파일 경로 (없으면 webhook 발송 생략)
SLACK_WEBHOOK_FILE=C:/Users/<USERNAME>/.claude-secrets/slack-webhook.txt

# Notion Integration 토큰 (https://www.notion.so/my-integrations 에서 발급)
# Phase 5 배포 시 notion-create-pages MCP 도구가 없는 환경(opencode 서브프로세스 등)에서
# scripts/notion_publish.py 폴백이 사용. team-config.yaml distribution.notion.data_source_id
# 데이터소스에 이 Integration 을 Connect 해야 함.
NOTION_API_TOKEN=secret_...
