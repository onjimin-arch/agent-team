# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# 허용 사용자 Slack User ID (본인 외 DM·멘션 무시)
SLACK_ALLOWED_USER_ID=U0XXXXXXX
# 여러 명 허용 시 콤마 구분 (SLACK_ALLOWED_USER_ID 와 합산)
# SLACK_ALLOWED_USER_IDS=U0XXXXXXX,U1YYYYYYY

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Agent runtime
# TEAM_ROOT: agent-team 폴더 절대경로 (슬래시 방향 무관)
TEAM_ROOT=C:/Users/<USERNAME>/OneDrive - 바로고/문서/클로드 코드 에이전트/agent-team

# opencode 모델 ID (anthropic/ prefix 없으면 자동 추가)
AGENT_MODEL=claude-sonnet-4-6

# Phase 5 Slack 배포 대상 채널. 채널명 대신 채널 ID(C로 시작)를 쓰면 이름 검색을 건너뛴다 —
# 채널이 많은 워크스페이스에서는 이름 검색이 탐색 한도 내에 못 찾을 수 있음(scripts/slack_publish.py 참고).
# 미설정 시 team-config.yaml 의 distribution.slack.channel 기본값(#oc-agent-log) 사용.
SLACK_REPORT_CHANNEL=C0XXXXXXX

# Notion Integration 토큰 (https://www.notion.so/my-integrations 에서 발급)
# Phase 5 배포 시 notion-create-pages MCP 도구가 없는 환경(opencode 서브프로세스 등)에서
# scripts/notion_publish.py 폴백이 사용. team-config.yaml distribution.notion.data_source_id
# 데이터소스에 이 Integration 을 Connect 해야 함.
NOTION_API_TOKEN=secret_...

# 다른 부서 Notion 워크스페이스 조회용 토큰 (위 NOTION_API_TOKEN과 다른 워크스페이스·다른 값 —
# 절대 혼용하지 말 것). 해당 부서 워크스페이스 관리자가 https://www.notion.so/my-integrations 에서
# Integration 을 발급하고 조회 대상 페이지/데이터소스에 Connect 해야 함.
# scripts/notion_fetch.py(member-alpha 의 외부 데이터소스 조회 역할)가 사용.
DEPT_NOTION_API_TOKEN=secret_...

# 사내 부서별 대시보드 API 키 (scripts/dashboard_fetch.py, member-alpha 의 외부 데이터소스 조회
# 역할이 사용). 대시보드마다 별도 키 환경변수를 추가한다 — 현재는 ERP만 발급됨.
# 각 대시보드의 base_url/엔드포인트는 .claude/skills/dept-dashboard-reader/SKILL.md 레지스트리 참조.
ERP_API_KEY=erp_...
# FIELD_API_KEY=      # 현장 — 스펙 확인 후 추가
# HR_API_KEY=         # 인사 — 스펙 확인 후 추가
# AX_API_KEY=         # AX — 스펙 확인 후 추가
# BRAND_API_KEY=      # 브랜드 — 스펙 확인 후 추가
# LEGAL_API_KEY=      # 법무 — 스펙 확인 후 추가
