{"nodes": [{"id": "output_on_premise_ai_final_final_artifact", "label": "\uc628\ud504\ub808\ubbf8\uc2a4 AI \uc885\ud569 \ub9ac\uc11c\uce58 (2026\ub144 4\uc6d4 \uae30\uc900) \u2014 \ucd5c\uc885\ubcf8", "file_type": "document", "source_file": "output/on-premise-ai/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "output_on_premise_ai_final_final_artifact_ai_\uae30\ubcf8\ubc95", "label": "AI \uae30\ubcf8\ubc95 (2026-01-22 \uc804\uba74 \uc2dc\ud589)", "file_type": "concept", "source_file": "output/on-premise-ai/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc628\ud504\ub808\ubbf8\uc2a4 \ucc44\ud0dd \ud310\ub2e8\uc758 \uccab \ud544\ud130. \uace0\uc601\ud5a5 AI \uc0ac\uc5c5\uc790(\uc758\ub8cc\u00b7\uae08\uc735\u00b7\ucc44\uc6a9\u00b7\uacf5\uacf5\uc11c\ube44\uc2a4)\uc758 \uc548\uc804\uc131\u00b7\uc2e0\ub8b0\uc131 \ud655\ubcf4, \uc601\ud5a5\ud3c9\uac00, \ubb38\uc11c\ud654, \ud22c\uba85\uc131 \uace0\uc9c0 \uc758\ubb34\uac00 \uacc4\ub3c4\uae30\uac04 \uc911\uc5d0\ub3c4 \uc774\ubbf8 \ud6a8\ub825\uc744 \uac00\uc9d0 \u2014 \ubbfc\uac10 \ub370\uc774\ud130\uc758 \ud574\uc678 API \uc720\ucd9c\uc774 \uc815\ub7c9\uc801 \ucef4\ud50c\ub77c\uc774\uc5b8\uc2a4 \ub9ac\uc2a4\ud06c\ub85c \uad00\ub9ac\ub418\uc5b4\uc57c \ud558\ub294 \uc774\uc720."}, {"id": "output_on_premise_ai_final_final_artifact_tco_decision_framework", "label": "TCO \uc190\uc775\ubd84\uae30 \uc758\uc0ac\uacb0\uc815 \ud504\ub808\uc784 (\uc6d4 \ud1a0\ud070\ub7c9 \uae30\uc900)", "file_type": "rationale", "source_file": "output/on-premise-ai/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc6d4 \ucd94\ub860 \ud1a0\ud070\ub7c9 \ud558\ub098\ub85c \uc628\ud504\ub808\ubbf8\uc2a4 vs \ud074\ub77c\uc6b0\ub4dc API \uc190\uc775\ubd84\uae30\ub97c \ub2e8\uc21c\ud654 \u2014 \uc911\uc18c 15~20\uc5b5, \uc911\uacac 30~40\uc5b5, \ub300\uaddc\ubaa8 200~300\uc5b5 \ud1a0\ud070/\uc6d4\uc774 \ubd84\uae30\uc810. \ud558\ub4dc\uc6e8\uc5b4 CapEx\ubcf4\ub2e4 MLOps \uc778\ub825(3\ub144 2FTE \uc774\uc0c1) \ud655\ubcf4 \uc5ec\ubd80\uac00 TCO \uac00\uc815\uc758 \uc131\ud328\ub97c \uc88c\uc6b0 \u2014 \uc778\ub825 \ud655\ubcf4 \uc2e4\ud328 \uc2dc TCO 30% \uc774\uc0c1 \uc99d\uac00."}, {"id": "output_on_premise_ai_final_final_artifact_\uc624\ud508\uc18c\uc2a4_\ub77c\uc774\uc120\uc2a4_\ud568\uc815", "label": "\uc624\ud508\uc18c\uc2a4 \ubaa8\ub378 \ub77c\uc774\uc120\uc2a4 \ud568\uc815 (Qwen/SOLAR/Llama)", "file_type": "rationale", "source_file": "output/on-premise-ai/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'\uc624\ud508\uc18c\uc2a4=\uc790\uc720 \uc0c1\uc5c5 \uc774\uc6a9' \uac00\uc815\uc774 \uc704\ud5d8\ud568\uc744 \ubcf4\uc5ec\uc8fc\ub294 3\ub300 \uc0ac\ub840 \u2014 Qwen 2.5 72B\ub294 Apache 2.0\uc774 \uc544\ub2cc Qwen License(MAU 1\uc5b5 \ucd08\uacfc \uc2dc \ubcc4\ub3c4\uacc4\uc57d), SOLAR 10.7B Instruct\ub294 CC-BY-NC-4.0\uc73c\ub85c \uc0c1\uc5c5 \uae08\uc9c0(base\ub9cc Apache 2.0), Llama \uacc4\uc5f4\uc740 MAU 7\uc5b5 \uc870\ud56d\uacfc \ud30c\uc0dd\ubaa8\ub378 \uba85\uce6d \ud45c\uae30 \uc758\ubb34. MoE \ubaa8\ub378\uc740 total/active \ud30c\ub77c\ubbf8\ud130\ub97c \ubd84\ub9ac\ud574\uc57c \ud558\ub4dc\uc6e8\uc5b4 \uc0ac\uc774\uc9d5\uc774 \uac00\ub2a5."}, {"id": "output_on_premise_ai_final_final_artifact_h200_b200_vram_\uc804\uc7c1", "label": "H200/B200 VRAM \uc804\uc7c1 (\ub871\ucee8\ud14d\uc2a4\ud2b8\u00b7MoE \uc2dc\ub300)", "file_type": "rationale", "source_file": "output/on-premise-ai/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2026\ub144 \ud558\ub4dc\uc6e8\uc5b4 \uc120\ud0dd \uae30\uc900\uc740 FLOPS\uac00 \uc544\ub2c8\ub77c VRAM\u00b7\ub300