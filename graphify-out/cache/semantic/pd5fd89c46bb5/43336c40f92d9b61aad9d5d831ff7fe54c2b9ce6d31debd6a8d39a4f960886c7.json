92500\ub9cc\uc6d0, 2027-01-01 \uc2dc\ud589)", "file_type": "concept", "source_file": "output/2026-\uc138\uc81c\uac1c\ud3b8\uc548-\ubd80\uac00\uac00\uce58\uc138/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc218\uce58\uc0c1 \uac00\uc7a5 \ud070 \ubcc0\ud654\uc774\uc9c0\ub9cc \ubc14\ub85c\uace0 \ubcf8\uc0ac \uc9c1\uc811 \uc138\uc561 \uc774\uc288\ubcf4\ub2e4 \uce74\ub4dc\ub9e4\ucd9c \ube44\uc911\uc774 \ub192\uc740 \ud30c\ud2b8\ub108(\uc74c\uc2dd\uc810 \ub4f1)\uc758 \uc190\uc775 \uc545\ud654\uc640 \ubb38\uc758 \uc99d\uac00\ub85c \uc774\uc5b4\uc9c8 \uac04\uc811 \uc601\ud5a5\uc73c\ub85c \ud574\uc11d\ud574\uc57c \uc2e4\ubb34\uc801\uc774\ub77c\ub294 \ud310\ub2e8"}, {"id": "output_2026_\uc138\uc81c\uac1c\ud3b8\uc548_\ubd80\uac00\uac00\uce58\uc138_concept_\uc678\uad6d\ubc95\uc778_\uc6a9\uc5ed\uac70\ub798_\uacfc\uc138\uaddc\uc815_\ubcf4\uc644", "label": "\uc678\uad6d\ubc95\uc778 \uc6a9\uc5ed\uac70\ub798 \uacfc\uc138\uaddc\uc815 \ubcf4\uc644 (\uad6d\ub0b4\uc0ac\uc5c5\uc7a5 \ubc1c\uae09 \uc2dc \uad6d\ub0b4\uc0ac\uc5c5\uc7a5\uc774 \uc2e0\uace0\u00b7\ub0a9\ubd80)", "file_type": "concept", "source_file": "output/2026-\uc138\uc81c\uac1c\ud3b8\uc548-\ubd80\uac00\uac00\uce58\uc138/final/final-artifact.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud574\uc678 SaaS\u00b7\uae30\uc220\uc6a9\uc5ed \uacc4\uc57d\uc774 \uc788\ub294 \uc870\uc9c1\uc5d0\ub9cc \uc911\uc694\ub3c4\uac00 \ucee4\uc9c0\ub294 \uc870\uac74\ubd80 \ud56d\ubaa9\uc73c\ub85c, \uc2dc\ud589\ub839 \ud655\uc815 \uc804\uc774\ub77c \uacc4\uc57d\uc11c\u00b7\uc99d\ube59 \ud750\ub984 \uc120\uc810\uac80\uc774 \uc548\uc804\ud558\ub2e4\ub294 \ud310\ub2e8"}, {"id": "output_2026_\uc138\uc81c\uac1c\ud3b8\uc548_\ubd80\uac00\uac00\uce58\uc138_concept_\ub3d9\uc0b0_\uc2e0\ud0c1\uc7ac\uc0b0_\uc0ac\uc5c5\uc790\ub4f1\ub85d_\ud569\ub9ac\ud654", "label": "\ub3d9\uc0b0 \uc2e0\u